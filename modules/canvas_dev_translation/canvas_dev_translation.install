<?php

declare(strict_types=1);

use Drupal\canvas\Entity\ContentTemplate;
use Drupal\canvas\Entity\Page;
use Drupal\canvas\Plugin\Field\FieldType\ComponentTreeItemList;
use Drupal\Core\Language\LanguageManagerInterface;
use Drupal\language\ConfigurableLanguageManagerInterface;
use Drupal\language\Entity\ConfigurableLanguage;

/**
 * Implements hook_install().
 *
 * Creates canvas_page and ContentTemplate entities with French translations
 * so that the language-prefixed layout API routes can be tested manually or
 * in automated tests without requiring a translation UI.
 *
 * @see \Drupal\Tests\canvas\Functional\TranslationTest::testCanvasDevTranslationLayoutApi()
 */
function canvas_dev_translation_install(): void {
  $language_manager = \Drupal::service(LanguageManagerInterface::class);
  \assert($language_manager instanceof ConfigurableLanguageManagerInterface);

  // Ensure French language exists; create it if not already present.
  if (!$language_manager->getLanguage('fr')) {
    ConfigurableLanguage::createFromLangcode('fr')->save();
    \Drupal::service('kernel')->rebuildContainer();
    $language_manager = \Drupal::service(LanguageManagerInterface::class);
    \assert($language_manager instanceof ConfigurableLanguageManagerInterface);
  }

  /** @var \Drupal\canvas\Entity\Component $heading_component */
  $heading_component = \Drupal::entityTypeManager()
    ->getStorage('component')
    ->load('sdc.canvas_test_sdc.heading');
  $version = $heading_component->getActiveVersion();

  // Create a canvas_page with a heading component and a French translation.
  $page = Page::create([
    'title' => 'Canvas Translation Test Page',
    'path' => '/canvas-translation-test',
    'status' => TRUE,
    'components' => [
      [
        'uuid' => '11111111-1111-4111-8111-111111111111',
        'component_id' => 'sdc.canvas_test_sdc.heading',
        'component_version' => $version,
        'inputs' => [
          'text' => 'Hello, Canvas!',
          'element' => 'h1',
        ],
        'label' => 'English heading',
      ],
    ],
  ]);
  $page->save();

  $fr_page = $page->addTranslation('fr');
  $fr_page->set('title', 'Page de test Canvas');
  // addTranslation() calls applyDefaultValue() for fields not passed in the
  // $values argument, so the French components field is initially empty. Copy
  // the English tree so we have a base to modify.
  $fr_page->set('components', $page->get('components')->getValue());
  $fr_tree = $fr_page->getComponentTree();
  \assert($fr_tree instanceof ComponentTreeItemList);
  $fr_item = $fr_tree->getComponentTreeItemByUuid('11111111-1111-4111-8111-111111111111');
  \assert($fr_item !== NULL);
  $fr_item->setInput(['text' => 'Bonjour, Canvas!', 'element' => 'h1'])
    ->setLabel('French heading');
  $fr_page->save();

  // Create a ContentTemplate for node/article/full with French language
  // override, but only if the article content type exists.
  $article_type = \Drupal::entityTypeManager()
    ->getStorage('node_type')
    ->load('article');
  if ($article_type === NULL) {
    return;
  }

  $template = ContentTemplate::create([
    'content_entity_type_id' => 'node',
    'content_entity_type_bundle' => 'article',
    'content_entity_type_view_mode' => 'full',
    'status' => TRUE,
    'component_tree' => [
      [
        'uuid' => '22222222-2222-4222-8222-222222222222',
        'component_id' => 'sdc.canvas_test_sdc.heading',
        'component_version' => $version,
        'inputs' => [
          'text' => 'Hello from template',
          'element' => 'h2',
        ],
        'label' => 'English template heading',
      ],
    ],
  ]);
  $template->save();

  $override = $language_manager->getLanguageConfigOverride('fr', $template->getConfigDependencyName());
  $override->setData([
    'component_tree' => [
      0 => [
        'label' => 'French template heading',
        'inputs' => ['text' => 'Bonjour du template'],
      ],
    ],
  ])->save();
}
