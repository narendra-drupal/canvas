<?php

/**
 * @file
 * Hook implementations for Drupal Canvas's foundational functionality.
 *
 * Other hook implementations live in include files.
 */

// @todo Re-evaluate this when A) tagging a stable release, B) https://www.drupal.org/project/drupal/issues/3398033 is fixed in Drupal core.
ini_set('assert.active', 1);

use Drupal\canvas\Entity\Component;
use Drupal\canvas\Plugin\Canvas\ComponentSource\GeneratedFieldExplicitInputUxComponentSourceBase;
use Drupal\canvas\PropSource\FieldStorageDefinition;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\tmgmt\Entity\JobItem;
use Drupal\tmgmt\Form\JobItemForm;

/**
 * Provides allowed values for a 'list_*' field used in a StaticPropSource.
 *
 * @see callback_allowed_values_function()
 * @see \Drupal\canvas\Plugin\Canvas\ComponentSource\GeneratedFieldExplicitInputUxComponentSourceBase::getOptionsForExplicitInputEnumProps()
 */
function canvas_load_allowed_values_for_component_prop(FieldStorageDefinitionInterface $canvas_field_storage_definition, ?FieldableEntityInterface $entity = NULL, bool &$cacheable = FALSE): array {
  // Allowed values can't be cached, as they not only depend on the prop but
  // also on which component is using it.
  $cacheable = FALSE;
  // We only accept this callback for props, not for real fields.
  assert($canvas_field_storage_definition instanceof FieldStorageDefinition);
  // @phpstan-ignore-next-line
  $canvas_form_display_options = $canvas_field_storage_definition->getDisplayOptions('form')['third_party_settings']['canvas'];
  [
    'component_id' => $component_id,
    'component_version' => $component_version,
    'explicit_input_prop_name' => $prop_name,
  ] = $canvas_form_display_options;
  $component = Component::load($component_id);

  // @see https://en.wikipedia.org/wiki/Robustness_principle
  if ($component === NULL) {
    return [];
  }

  $component->loadVersion($component_version);

  // StaticPropSources are only used for ComponentSources with a generated input
  // UX using fields.
  $source = $component->getComponentSource();
  assert($source instanceof GeneratedFieldExplicitInputUxComponentSourceBase);

  return $source->getOptionsForExplicitInputEnumProp($prop_name);
}

/**
 * Implements hook_preprocess_HOOK() for regions.
 *
 * @see \Drupal\canvas\Render\MainContent\CanvasPreviewRenderer::prepare()
 */
function canvas_preprocess_region(array &$variables):void {
  if (!\array_key_exists('#canvas_region_preview', $variables['elements'])) {
    // Nothing to do: this is a region being rendered outside of a Canvas
    // preview context.
    return;
  }

  $region = $variables['region'];
  assert(is_string($region) && strlen($region) >= 1);

  $content = (string) $variables['content'];

  // Additional `content-start` and `content-end` comment annotations to
  // surround just the {{ content }} output to allow Canvas's UI to more
  // accurately render the region overlays.
  $variables['content'] = Markup::create(<<<HTML
<!-- canvas-region-content-start-$region -->
$content
<!-- canvas-region-content-end-$region -->
HTML);
}

/**
 * Implements hook_preprocess_form_element().
 */
function canvas_preprocess_form_element(array &$variables): void {
  if (!isset($variables['label'])) {
    return;
  }

  if (isset($variables['element']['#form_id'])) {
    $variables['label']['#form_id'] = $variables['element']['#form_id'];
  }
}

/**
 * Implements hook_preprocess_HOOK() for html.
 */
function canvas_preprocess_html(array &$variables): void {
  $current_route = \Drupal::routeMatch()->getRouteName();
  if ($current_route === 'entity.canvas_page.canonical') {
    $variables['attributes']['class'][] = 'canvas-page';
  }
}

/**
 * Implements hook_entity_prepare_form().
 *
 * Pre-populates TMGMT job item form with existing translation data so users
 * see their previous translations when editing. Only modifies the entity in
 * memory — data persists to DB only when user submits the form.
 */
function canvas_entity_prepare_form(EntityInterface $entity, string $operation, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof JobItemForm) {
    return;
  }
  if (!$entity instanceof JobItem) {
    return;
  }

  // Only pre-populate if job item has no translated data saved yet.
  /** @var \Drupal\tmgmt\Data $data_service */
  $data_service = \Drupal::service('tmgmt.data');
  $data = $entity->getData();
  $translatable_items = $data_service->filterTranslatable($data);
  foreach ($translatable_items as $item) {
    if (!empty($item['#translation']['#text'])) {
      // User already saved progress — don't overwrite.
      return;
    }
  }

  // Check if source entity has an existing translation for target language.
  $target_langcode = $entity->getJob()->getTargetLangcode();
  $plugin = $entity->get('plugin')->value;

  if ($plugin === 'content') {
    $source_entity = \Drupal::entityTypeManager()
      ->getStorage($entity->getItemType())
      ->load($entity->getItemId());
    if (!$source_entity || !$source_entity instanceof \Drupal\Core\Entity\TranslatableInterface) {
      return;
    }
    if (!$source_entity->hasTranslation($target_langcode)) {
      return;
    }

    $translation = $source_entity->getTranslation($target_langcode);
    /** @var \Drupal\tmgmt_content\Plugin\tmgmt\Source\ContentEntitySource $source_plugin */
    $source_plugin = $entity->getSourcePlugin();
    $translation_data = $source_plugin->extractTranslatableData($translation);

    // Walk the translation data and set #translation.#text on each item.
    $flat_translation = $data_service->filterTranslatable($translation_data);
    foreach ($flat_translation as $key => $item) {
      if (!empty($item['#text'])) {
        $key_array = explode('][', $key);
        $entity->updateData($key_array, [
          '#translation' => [
            '#text' => $item['#text'],
            '#origin' => 'existing',
          ],
          '#status' => TMGMT_DATA_ITEM_STATE_TRANSLATED,
        ]);
      }
    }
  }
}
